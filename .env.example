AUTH_TOKEN=change-me
GITHUB_TOKEN=change-me
DATABASE_URL=sqlite+aiosqlite:///data/orchestrator.db
LM_STUDIO_URL=http://host.docker.internal:1234
AGENT_MODEL=claude-opus-4-8
HOST=0.0.0.0
# Host port Praxis is published on. 12323 is a deliberately uncommon default to
# avoid colliding with other local services (e.g. SearXNG/dashboards on 8080).
# This is the port the MCP adapter's PRAXIS_BASE_URL and agent callbacks use,
# so keep them in sync if you change it. (Inside the container the app always
# binds 8080; only the host-side mapping changes.)
PORT=12323
