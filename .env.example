AUTH_TOKEN=change-me

# Optional: stamp a build id on /health and /api/status (else derived from git).
# PRAXIS_BUILD_SHA=

# Per-project `verify_cmd` (set via the API, not here) runs an
# operator-configured shell command against each PR checkout BEFORE the brain
# review. A non-zero exit fails the task deterministically. It is TRUSTED config,
# never taken from a PR. Prefer running the orchestrator itself in a container.
#
# GitHub credentials are configured further down under "GitHub authentication".
# Praxis parks reviewed PRs for human approval by default (auto_merge off) and
# never auto-merges into a protected branch (main/master/release*). Pair your
# credentials with GitHub branch protection on your default branch so the gate is
# enforced by GitHub even if orchestrator logic is bypassed.
DATABASE_URL=sqlite+aiosqlite:///data/orchestrator.db
LM_STUDIO_URL=http://host.docker.internal:1234
AGENT_MODEL=claude-opus-4-8
HOST=0.0.0.0
# Host port Praxis is published on. 12323 is a deliberately uncommon default to
# avoid colliding with other local services (e.g. SearXNG/dashboards on 8080).
# This is the port the MCP adapter's PRAXIS_BASE_URL and agent callbacks use,
# so keep them in sync if you change it. (Inside the container the app always
# binds 8080; only the host-side mapping changes.)
PORT=12323

# --- Agent commit identity ---------------------------------------------------
# Git author name/email that worker containers commit under. The commit profile
# carries no Praxis footprint (Praxis only connects to the worker model; the
# configured model is what implements). Leave unset to use the built-in default,
# or uncomment and set your own identity / a dedicated bot account.
# GIT_AUTHOR_NAME=dev-bot
# GIT_AUTHOR_EMAIL=dev-bot@users.noreply.github.com

# --- GitHub authentication ---------------------------------------------------
# Praxis needs GitHub credentials to clone repos, push agent branches, and open
# PRs. Configure ONE of the two options below. When both are present, the GitHub
# App takes precedence over the PAT.
#
# Option A (RECOMMENDED): a GitHub App. When GITHUB_APP_ID and
# GITHUB_APP_PRIVATE_KEY are both set, Praxis mints short-lived, repo-scoped
# installation tokens (contents:write + pull_requests:write) instead of using a
# broad, long-lived PAT. A leaked token is then narrow and expires within the hour.
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY=/run/secrets/praxis-app.pem   # PEM contents or a file path
# GITHUB_APP_INSTALLATION_ID=  # optional; auto-resolved per repo when unset
#
# Option B (fallback): a Personal Access Token, used only when no GitHub App is
# configured. Scope it least-privilege (contents:write + pull_requests:write only);
# do NOT grant admin or branch-protection-bypass.
# GITHUB_TOKEN=ghp_your_token_here
