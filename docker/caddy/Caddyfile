{$DOMAIN:localhost} {
    reverse_proxy orchestrator:8080

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    @api path /api/*
    handle @api {
        reverse_proxy orchestrator:8080
    }

    handle {
        reverse_proxy orchestrator:8080
    }

    log {
        output stdout
        format console
    }
}
