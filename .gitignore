*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

.venv/
venv/

.env

# Container-only variables (hook opt-outs and anything else that must reach
# the orchestrator PROCESS rather than compose's substitution context). Kept
# out of git so following `praxis doctor`'s remedy never dirties a tracked
# file: the remedy used to be "add a literal to docker-compose.yml", which
# leaves a permanent diff in a fresh clone.
.env.container

.vscode/
.idea/
CLAUDE.local.md

# Local Claude Code / MCP config
.claude/settings.local.json
.claude/scheduled_tasks.lock
.mcp.json

htmlcov/
.coverage
.pytest_cache/

# Local runtime + E2E artifacts (DBs, logs, run logs, scratch JSON). Keep the
# directory itself via .gitkeep so the app can create data/orchestrator.db.
data/*
!data/.gitkeep

.superpowers/
.worktrees/
.playwright-mcp/

Thumbs.db
.DS_Store

# Playwright MCP screenshot artifacts
.playwright-mcp/

# Social launch drafts (private, not for commit)
docs/social-launch*

# Session handoff prompt (local working note, regenerated each phase close)
HANDOFF.md
TODO.md

# Bench working directory: fetched pools and prepared bare repos (hundreds of
# MB). bench/samples/ is NOT covered by this and stays committed.
bench/.work/

# Compose's own local-override file. Its whole purpose is a machine-specific
# edit compose picks up automatically for every `docker compose` run in this
# directory, so it must never be committed: a bind-mount source naming one
# operator's home directory would break the next person's `up -d` silently.
# It is also invisible in a `docker compose config` run that is not pinned
# with `-f docker-compose.yml`, which is how the local-repos tests were caught
# validating a merged config that was not the shipped one.
docker-compose.override.yml
